FROM golang:1.19-alpine

# 安装依赖
RUN apk --no-cache add ca-certificates git inotify-tools

# 设置工作目录
WORKDIR /app

# 复制go.mod和go.sum
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 创建热更新启动脚本
RUN echo '#!/bin/sh\n\
# 安装fswatch用于文件监控（在alpine中替代inotifyd）\n\
apk add --no-cache fswatch\n\
\n\
# 启动监控脚本\n\
echo "#!/bin/sh" > /app/watch.sh\n\
echo "while true; do" >> /app/watch.sh\n\
echo "  echo \"Monitoring for changes...\"" >> /app/watch.sh\n\
echo "  go build -o main ." >> /app/watch.sh\n\
echo "  if [ -f main ]; then" >> /app/watch.sh\n\
echo "    echo \"Starting application...\"" >> /app/watch.sh\n\
echo "    ./main &" >> /app/watch.sh\n\
echo "    APP_PID=\$!" >> /app/watch.sh\n\
echo "    echo \"Application started with PID \$APP_PID\"" >> /app/watch.sh\n\
echo "    # 监听.go文件变化" >> /app/watch.sh\n\
echo "    fswatch -0 -e '\\.git' -i '\\.go$' . | xargs -0 -n 1 sh -c 'echo \"File changed, restarting...\"; kill \$APP_PID; exit 0' &" >> /app/watch.sh\n\
echo "    wait \$APP_PID" >> /app/watch.sh\n\
echo "  fi" >> /app/watch.sh\n\
echo "done" >> /app/watch.sh\n\
chmod +x /app/watch.sh

# 暴露端口
EXPOSE 8081

# 运行启动脚本
CMD ["/app/watch.sh"]