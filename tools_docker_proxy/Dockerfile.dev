FROM golang:1.19-alpine

# 安装依赖
RUN apk --no-cache add ca-certificates git inotify-tools

# 设置工作目录
WORKDIR /app

# 复制go.mod和go.sum
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 创建热更新启动脚本
RUN echo '#!/bin/sh\n\
while true; do\n\
  echo "Building application..."\n\
  go build -o main .\n\
  if [ -f main ]; then\n\
    echo "Starting application..."\n\
    ./main &\n\
    PID=$!\n\
    echo "Application started with PID $PID"\n\
    # 监听.go文件变化\n\
    inotifyd "kill $PID; exit 0" . go &\n\
    wait $PID\n\
  fi\n\
done' > /app/start.sh && chmod +x /app/start.sh

# 暴露端口
EXPOSE 8081

# 运行启动脚本
CMD ["/app/start.sh"]