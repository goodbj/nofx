# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
NOFX_BACKEND_PORT=8888

# Frontend web interface port
NOFX_FRONTEND_PORT=3300

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Logging Configuration
# ===========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
# 下面的这个示例是一个在其他容器里能正常运行的格式，严格按照这个格式编写
# 这是正确的格式 ==>  RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEA7ZAy8I/xU3/pv7MZ25nHgRD1XSrCMHtH2OL/qwqCvkvGCRhS\nXoVSsimeeBB/PNSU3iYD6BrXaYk7YKnuzHhftiRq/D4I+itjY0jf24UyJ6KmfT6s\nKQAjWxTsOEQUktrfFXaGIg2e+KhpYXnZze2PUDnNWxNqfi6PEEqlOEbd/fzzThY0\nem6T9RH7wawScVUR6w3v3olO+BUsu02kHXDkQ1YPPcrHgoTQ8pxHUm/3N/feDqwn\n/Ub4kvbg88mZvEgRldRgAECtXBMk1CKzXQNPRYxTSckKffSUVqCEzrPkix/TFVGR\nQE7iaCAEBvT5aqDo+dMsxkDULnsQGC/4WXcPSwIDAQABAoIBADXVtS19uSb+eDao\nfCYfMa5GbQwJags5jL0SJ/UXQyyjmEOsXtIrrWNReidkOalL1VaIT99T4df5MNsF\nd2efqbTpiNMTrc4fcfzoYU5qX0TLH6aHQtVhwiFcWvGfP/hNoDtJajkiVBGufH8J\n8Xkwqgb4qlhGzJ2+qE39VHat3JW3QpXcuXH/PZoe1IJq4otwDujUdZGYRYSH/ZlF\nbhyIQfL0RkFknySK3XgtrloEyawPPbPs92ofxNH0mAOvuRYMFExbp00r0fP7QL/Y\nKyAe5DsWuYOlzlKRusrN0Y3sJFhIyoRr25w0p8Qez2W1km4ryj31v+qarCrlj2le\n7Dtio0kCgYEA82VZRhdKR5Jti5TOg/WmNL58OUniN1BrfIIHRSOGTFkqI7XkzQXV\nETzZoJcXVq8+HBiaKVkTtc4DHxQS9RwXzqxyGkSSiBovixbPKhPc+D/m0FZTaqnP\nkXGT9QVdY00PapZb3P3gFK3VlXvbh/dDgPFFPFpaRifaIQHvr0VDPGMCgYEA+d2H\nRlY8iEddjly1nk0qmJa4Bl8MIrdQbmpvakI6q3DizeoMvGduyjK6ciDy++T9Zqb7\niYeOqaNFniuqZCmBukOPzVD2QXYHROm9W08P1tQXCxfyAmKcLxLJUA5TrpPt792T\n2yDpCK7lRATAlRfdip2j4DHwR9NjBVMBw5ISUfkCgYBW/1XOkMqTFIqlRpYeYrJ6\nzc9XJsp93PfedBenJdB9/6zpQL28bqY+2BItrXPBHzhDEKQhvV4nMLC67hDsnZMA\n43CRZQs/LKTrwUZhEuJ7tVOKCiEc0f+ITCGHhdhggw3MmlvRfMkYex4JpVDNo5r0\nPsjxjpYP13THMYr7ifVDYwKBgHWyw2D/iD4Nl+VSiH7MDK+Z94+QwC+uOCX63wan\nselGIKAsitlIw6hdYvQVzz+Wq0Lqj3xGLY59CXMrUHUkFCbAYoGtjIJjbaMpk3fq\ncySX/U7NdcNn3fhSmh+q0AJhTmh58Ib9JqhfckGrF2hjuIjuHt6hx3Sd/3vnkOIl\n8ZlJAoGAJISsNmC58IXZat/BeGGtoVKxCB++F9R5MBszmJdwuMrL+DYeWqpXLC54\naIJaQrYj7KjQ/wXP9PM3pndll8RvsbM7kOwJ56FnJk+1wZxGosXENhgHLbkZoBBD\nHHpT8ePjQ87geH1/X8wbI7YIvAg/Rh8bDMkfDBA/kmIC06zUvFI=\n-----END RSA PRIVATE KEY-----\n"
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=nofx_user
DB_PASSWORD=
DB_NAME=nofx
DB_SSLMODE=disable


# 数据库配置 - SQLite（默认）
DB_TYPE=sqlite
DB_PATH=data/data.db

# ===========================================
# AI Model Token Limits Configuration
# ===========================================

# Model token limits (characters/tokens) - 用于AI测试输出框的字符限制显示
# 注意：这些值是供前端显示参考的，默认单位为字符数
# 请勿随意修改此值，除非您了解不同AI模型的实际限制
# 如果删除这些变量，程序将使用内置的默认值

# DeepSeek 模型最大token数
MODEL_MAX_TOKENS_DEEPSEEK=32768

# GPT-4 模型最大token数
MODEL_MAX_TOKENS_GPT4=128000

# GPT-3.5 模型最大token数
MODEL_MAX_TOKENS_GPT35=16384

# Claude 模型最大token数
MODEL_MAX_TOKENS_CLAUDE=200000

# 通义千问(Qwen) 模型最大token数
MODEL_MAX_TOKENS_QWEN=32768

# 默认模型最大token数
MODEL_MAX_TOKENS_DEFAULT=4096

# ===========================================
# AI Model Pricing Configuration (for cost estimation)
# ===========================================

# Model pricing (per million tokens) - 用于AI测试输出框的成本估算
# 注意：这些值是供前端估算参考的，单位为元(RMB)或美元(USD)
# 请勿随意修改此值，除非您了解不同AI模型的实际价格
# 如果删除这些变量，程序将使用内置的默认值

# 通义千问系列
MODEL_PRICE_QWEN_MAX_INPUT=2.40      # qwen-max 输入价格 (元/百万tokens)
MODEL_PRICE_QWEN_MAX_OUTPUT=9.60     # qwen-max 输出价格 (元/百万tokens)
MODEL_PRICE_QWEN_PLUS_INPUT=1.00     # qwen-plus 输入价格 (元/百万tokens) - 使用平均值
MODEL_PRICE_QWEN_PLUS_OUTPUT=4.00    # qwen-plus 输出价格 (元/百万tokens) - 使用平均值

# OpenAI GPT系列
MODEL_PRICE_GPT4O_INPUT=2.50         # GPT-4o 输入价格 (美元/百万tokens)
MODEL_PRICE_GPT4O_OUTPUT=10.00       # GPT-4o 输出价格 (美元/百万tokens)
MODEL_PRICE_GPT4OMINI_INPUT=0.15     # GPT-4o-mini 输入价格 (美元/百万tokens)
MODEL_PRICE_GPT4OMINI_OUTPUT=0.60    # GPT-4o-mini 输出价格 (美元/百万tokens)

# Anthropic Claude系列
MODEL_PRICE_CLAUDE_SONNET_INPUT=3.00 # Claude 3.7 Sonnet 输入价格 (美元/百万tokens)
MODEL_PRICE_CLAUDE_SONNET_OUTPUT=15.00 # Claude 3.7 Sonnet 输出价格 (美元/百万tokens)

# DeepSeek系列
MODEL_PRICE_DEEPSEEK_INPUT=0.20      # Deepseek-Chat 输入价格 (元/百万tokens) - 按2元/百万tokens换算
MODEL_PRICE_DEEPSEEK_OUTPUT=0.80     # Deepseek-Chat 输出价格 (元/百万tokens) - 按8元/百万tokens换算

# 百度文心系列
MODEL_PRICE_WENXIN_ERINIE35_INPUT=0.08 # ERNIE-3.5-8K 输入价格 (元/百万tokens) - 按0.8元/百万tokens换算
MODEL_PRICE_WENXIN_ERINIE35_OUTPUT=0.20 # ERNIE-3.5-8K 输出价格 (元/百万tokens) - 按2元/百万tokens换算

# 默认价格 (当找不到特定模型价格时使用)
MODEL_PRICE_DEFAULT_INPUT=0.50       # 默认输入价格 (元/百万tokens)
MODEL_PRICE_DEFAULT_OUTPUT=2.00      # 默认输出价格 (元/百万tokens)

# ===========================================
# Cost Display Configuration
# ===========================================

# Cost display unit (USD, CNY, or BOTH) - 设置成本显示单位
# USD: 只显示美元价格
# CNY: 只显示人民币价格
# BOTH: 同时显示美元和人民币价格
COST_DISPLAY_UNIT=BOTH

# Exchange rate configuration (when showing CNY prices)
# 汇率配置 (当显示人民币价格时使用)
USD_TO_CNY_RATE=7.2                  # 1美元兑换多少人民币 (根据实际汇率调整)