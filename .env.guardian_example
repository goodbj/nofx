# Guardian Browser Automation Configuration
# 用于配置Guardian浏览器自动化功能的环境变量

# 基础配置
GUARDIAN_TARGET_URL=https://chat.deepseek.com/
GUARDIAN_INPUT_SELECTOR=#prompt-textarea
GUARDIAN_BUTTON_SELECTOR=button[type='submit']
GUARDIAN_RESPONSE_SELECTOR=.font-light

# 浏览器显示配置
GUARDIAN_DISPLAY_ENABLED=true
DOCKER_ENV=  # 注释掉或留空以在非Docker环境运行

# Chrome路径配置（可选，通常自动检测）
# GUARDIAN_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 浏览器超时时间配置（以秒为单位）
GUARDIAN_BROWSER_TIMEOUT_SECONDS=60        # 自动模式下的浏览器超时时间，默认60秒
GUARDIAN_MANUAL_BROWSER_TIMEOUT_SECONDS=600 # 手动模式下的浏览器超时时间，默认600秒（10分钟）

# 手动模式 - 设置为true时浏览器会保持打开状态供用户手动操作
GUARDIAN_MANUAL_MODE=false

# 其他配置
GUARDIAN_FORCE_BROWSER_REQUIRED=true      # 设置为true时如果没有找到浏览器会报错
GUARDIAN_VALIDATION_MODE=relaxed        # 设置为strict时会更严格地验证AI服务类型