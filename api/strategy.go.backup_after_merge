

 // handleGetStrategies gets all strategies for the user func (s *Server) handleGetStrategies(c *gin.Context) { 	userID := c.GetString("user_id") 	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	strategies, err := s.store.Strategy().List(userID) 	if err != nil { 		logger.Errorf("Failed to get strategies for user %s: %v", userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get strategies"}) 		return 	}  	// Get active strategy 	activeStrategy, err := s.store.Strategy().GetActive(userID) 	if err != nil { 		logger.Warnf("Failed to get active strategy for user %s: %v", userID, err) 	}  	// Mark which strategy is active and parse configs 	for i := range strategies { 		if activeStrategy != nil && strategies[i].ID == activeStrategy.ID { 			strategies[i].IsActive = true 		} 		// Parse the config to make it available in the response 		_, err := strategies[i].ParseConfig() 		if err == nil { 			// We'll add the parsed config to the response separately 		} 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategies": strategies, 		"count":      len(strategies), 	}) }  // handleGetActiveStrategy gets the active strategy for the user func (s *Server) handleGetActiveStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	strategy, err := s.store.Strategy().GetActive(userID) 	if err != nil { 		// If no active strategy found, return empty response 		if err == gorm.ErrRecordNotFound { 			c.JSON(http.StatusOK, gin.H{ 				"strategy": nil, 				"message":  "No active strategy set", 			}) 			return 		} 		logger.Errorf("Failed to get active strategy for user %s: %v", userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get active strategy"}) 		return 	}  	// Parse the config to make it available in the response 	_, err = strategy.ParseConfig() 	if err == nil { 		// Add the parsed config to the response separately 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategy": strategy, 	}) }  // handleGetStrategy gets a specific strategy by ID func (s *Server) handleGetStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	id := c.Param("id")  	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	if id == "" { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Strategy ID is required"}) 		return 	}  	strategy, err := s.store.Strategy().Get(userID, id) 	if err != nil { 		logger.Errorf("Failed to get strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get strategy"}) 		return 	}  	// Parse the config to make it available in the response 	_, err = strategy.ParseConfig() 	if err == nil { 		// Add the parsed config to the response separately 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategy": strategy, 	}) }  // handleCreateStrategy creates a new strategy func (s *Server) handleCreateStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	var req struct { 		Name          string               `json:"name" binding:"required"` 		Description   string               `json:"description"` 		Config        store.StrategyConfig `json:"config" binding:"required"` 		IsPublic      *bool                `json:"is_public,omitempty"`      // Optional - defaults to false 		ConfigVisible *bool                `json:"config_visible,omitempty"` // Optional - defaults to true 	}  	if err := c.ShouldBindJSON(&req); err != nil { 		SafeBadRequest(c, "Invalid request parameters") 		return 	}  	// Generate a new ID for the strategy 	strategyID := generateStrategyID()  	// Create the strategy object 	newStrategy := &store.Strategy{ 		ID:            strategyID, 		UserID:        userID, 		Name:          req.Name, 		Description:   req.Description, 		IsPublic:      false, 		ConfigVisible: true, 		IsActive:      false, 		IsDefault:     false, 		CreatedAt:     time.Now(), 		UpdatedAt:     time.Now(), 	}  	// Apply optional fields if provided 	if req.IsPublic != nil { 		newStrategy.IsPublic = *req.IsPublic 	} 	if req.ConfigVisible != nil { 		newStrategy.ConfigVisible = *req.ConfigVisible 	}  	// Serialize the config to JSON string 	if err := newStrategy.SetConfig(&req.Config); err != nil { 		logger.Errorf("Failed to serialize config for strategy %s: %v", strategyID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save strategy config"}) 		return 	}  	// Save to database 	if err := s.store.Strategy().Create(newStrategy); err != nil { 		logger.Errorf("Failed to create strategy for user %s: %v", userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create strategy"}) 		return 	}  	logger.Infof("âœ?Strategy created: %s for user %s", strategyID, userID)  	// Parse the config to make it available in the response 	_, parseErr := newStrategy.ParseConfig() 	if parseErr == nil { 		// Add the parsed config to the response separately 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategy": newStrategy, 		"message":  "Strategy created successfully", 	}) }  // handleUpdateStrategy updates an existing strategy func (s *Server) handleUpdateStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	id := c.Param("id")  	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	if id == "" { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Strategy ID is required"}) 		return 	}  	var req struct { 		Name          string                `json:"name"` 		Description   string                `json:"description"` 		Config        *store.StrategyConfig `json:"config"` // pointer to detect if provided 		IsPublic      *bool                 `json:"is_public,omitempty"` 		ConfigVisible *bool                 `json:"config_visible,omitempty"` 	}  	if err := c.ShouldBindJSON(&req); err != nil { 		SafeBadRequest(c, "Invalid request parameters") 		return 	}  	// Get existing strategy to verify ownership and current state 	existing, err := s.store.Strategy().Get(userID, id) 	if err != nil { 		logger.Errorf("Failed to get strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get strategy"}) 		return 	}  	// Update the strategy fields if provided 	if req.Name != "" { 		existing.Name = req.Name 	} 	if req.Description != "" { 		existing.Description = req.Description 	} 	if req.Config != nil { 		// Serialize the config to JSON string 		if err := existing.SetConfig(req.Config); err != nil { 			logger.Errorf("Failed to serialize config for strategy %s: %v", id, err) 			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save strategy config"}) 			return 		} 	} 	if req.IsPublic != nil { 		existing.IsPublic = *req.IsPublic 	} 	if req.ConfigVisible != nil { 		existing.ConfigVisible = *req.ConfigVisible 	}  	existing.UpdatedAt = time.Now()  	// Update in database 	if err := s.store.Strategy().Update(existing); err != nil { 		logger.Errorf("Failed to update strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update strategy"}) 		return 	}  	logger.Infof("âœ?Strategy updated: %s for user %s", id, userID)  	// Parse the config to make it available in the response 	_, parseErr := existing.ParseConfig() 	if parseErr == nil { 		// Add the parsed config to the response separately 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategy": existing, 		"message":  "Strategy updated successfully", 	}) }  // handleDeleteStrategy deletes a strategy func (s *Server) handleDeleteStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	id := c.Param("id")  	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	if id == "" { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Strategy ID is required"}) 		return 	}  	// Get strategy to verify ownership and check if it's active 	strategy, err := s.store.Strategy().Get(userID, id) 	if err != nil { 		logger.Errorf("Failed to get strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get strategy"}) 		return 	}  	// Don't allow deletion of default strategies 	if strategy.IsDefault { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Cannot delete default strategy"}) 		return 	}  	// If this is the active strategy, deactivate it first by setting another strategy as active 	// or by deactivating it if no other strategies exist 	if strategy.IsActive { 		// Find another strategy for this user to make active, or set active to false 		otherStrategies, err := s.store.Strategy().List(userID) 		if err != nil { 			logger.Errorf("Failed to get strategies to determine new active: %v", err) 			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to determine new active strategy"}) 			return 		}  		var newActiveStrategy *store.Strategy 		for _, s := range otherStrategies { 			if s.ID != id && !s.IsDefault { 				newActiveStrategy = s 				break 			} 		}  		// If we found another strategy, make it active; otherwise just deactivate the current one 		if newActiveStrategy != nil { 			if err := s.store.Strategy().SetActive(userID, newActiveStrategy.ID); err != nil { 				logger.Errorf("Failed to set new active strategy: %v", err) 				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to set new active strategy"}) 				return 			} 		} else { 			// Just update the current strategy to be inactive 			strategy.IsActive = false 			strategy.UpdatedAt = time.Now() 			if err := s.store.Strategy().Update(strategy); err != nil { 				logger.Errorf("Failed to deactivate strategy: %v", err) 				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to deactivate strategy"}) 				return 			} 		} 	}  	// Delete from database 	if err := s.store.Strategy().Delete(userID, id); err != nil { 		logger.Errorf("Failed to delete strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to delete strategy"}) 		return 	}  	logger.Infof("âœ?Strategy deleted: %s for user %s", id, userID)  	c.JSON(http.StatusOK, gin.H{ 		"message": "Strategy deleted successfully", 	}) }  // handleGetDefaultStrategyConfig returns the default strategy configuration func (s *Server) handleGetDefaultStrategyConfig(c *gin.Context) { 	lang := c.Query("lang") 	if lang == "" { 		lang = "en" 	}  	defaultConfig := store.GetDefaultStrategyConfig(lang)  	c.JSON(http.StatusOK, gin.H{ 		"config":  defaultConfig, 		"message": "Default strategy configuration", 	}) }  // handleGetAnnotatedStrategyConfig returns the strategy configuration with annotations func (s *Server) handleGetAnnotatedStrategyConfig(c *gin.Context) { 	lang := c.Query("lang") 	if lang == "" { 		lang = "en" 	}  	// For now, just return the default config with an annotation message 	defaultConfig := store.GetDefaultStrategyConfig(lang)  	c.JSON(http.StatusOK, gin.H{ 		"config":     defaultConfig, 		"message":    "Strategy configuration with annotations", 		"annotation": "This configuration includes all strategy parameters with explanatory comments", 	}) }  // handlePreviewPrompt previews the prompt that would be sent to AI func (s *Server) handlePreviewPrompt(c *gin.Context) { 	userID := c.GetString("user_id") 	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	var req struct { 		Config        store.StrategyConfig `json:"config" binding:"required"` 		PromptVariant string               `json:"prompt_variant"` 	}  	if err := c.ShouldBindJSON(&req); err != nil { 		SafeBadRequest(c, "Invalid request parameters") 		return 	}  	if req.PromptVariant == "" { 		req.PromptVariant = "balanced" 	}  	// This function would be implemented to preview prompts 	// For now, return a placeholder response 	c.JSON(http.StatusOK, gin.H{ 		"message": "Prompt preview functionality would be implemented here", 		"config":  req.Config, 		"variant": req.PromptVariant, 	}) }  // handleActivateStrategy activates a strategy func (s *Server) handleActivateStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	id := c.Param("id")  	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	if id == "" { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Strategy ID is required"}) 		return 	}  	// Verify strategy exists and belongs to user 	_, err := s.store.Strategy().Get(userID, id) 	if err != nil { 		logger.Errorf("Failed to get strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get strategy"}) 		return 	}  	// Set as active strategy 	if err := s.store.Strategy().SetActive(userID, id); err != nil { 		logger.Errorf("Failed to activate strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to activate strategy"}) 		return 	}  	logger.Infof("âœ?Strategy activated: %s for user %s", id, userID)  	c.JSON(http.StatusOK, gin.H{ 		"message": "Strategy activated successfully", 	}) }  // handleDuplicateStrategy duplicates an existing strategy func (s *Server) handleDuplicateStrategy(c *gin.Context) { 	userID := c.GetString("user_id") 	id := c.Param("id")  	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	if id == "" { 		c.JSON(http.StatusBadRequest, gin.H{"error": "Strategy ID is required"}) 		return 	}  	var req struct { 		Name string `json:"name" binding:"required"` 	}  	if err := c.ShouldBindJSON(&req); err != nil { 		SafeBadRequest(c, "Invalid request parameters") 		return 	}  	// Generate a new ID for the duplicated strategy 	newID := generateStrategyID()  	// Duplicate the strategy 	if err := s.store.Strategy().Duplicate(userID, id, newID, req.Name); err != nil { 		logger.Errorf("Failed to duplicate strategy %s for user %s: %v", id, userID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to duplicate strategy"}) 		return 	}  	// Get the duplicated strategy to return 	duplicated, err := s.store.Strategy().Get(userID, newID) 	if err != nil { 		logger.Errorf("Failed to get duplicated strategy %s: %v", newID, err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get duplicated strategy"}) 		return 	}  	// Parse the config to make it available in the response 	_, parseErr := duplicated.ParseConfig() 	if parseErr == nil { 		// Add the parsed config to the response separately 	}  	logger.Infof("âœ?Strategy duplicated: %s -> %s for user %s", id, newID, userID)  	c.JSON(http.StatusOK, gin.H{ 		"strategy": duplicated, 		"message":  "Strategy duplicated successfully", 	}) }  // handlePublicStrategies gets all public strategies func (s *Server) handlePublicStrategies(c *gin.Context) { 	// Get all public strategies 	strategies, err := s.store.Strategy().ListPublic() 	if err != nil { 		logger.Errorf("Failed to get public strategies: %v", err) 		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to get public strategies"}) 		return 	}  	// Filter out configs if they're not visible 	for i := range strategies { 		if !strategies[i].ConfigVisible { 			// Clear the config field if not visible 			strategies[i].Config = "{}" 		} 		// Parse the config to make it available in the response if visible 		_, err := strategies[i].ParseConfig() 		if err == nil { 			// We'll add the parsed config to the response separately 		} 	}  	c.JSON(http.StatusOK, gin.H{ 		"strategies": strategies, 		"count":      len(strategies), 	}) }  // handleGenerateFullPrompt generates a full AI prompt for manual copy func (s *Server) handleGenerateFullPrompt(c *gin.Context) { 	userID := c.GetString("user_id") 	if userID == "" { 		c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}) 		return 	}  	var req struct { 		Config store.StrategyConfig   `json:"config"` 		Data   map[string]interface{} `json:"dat