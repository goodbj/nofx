# 使用官方Go镜像作为构建环境
FROM golang:1.25-alpine AS builder

# 设置工作目录
WORKDIR /app

# 配置Go模块代理以加速下载（适用于中国用户）
ENV GOPROXY=https://goproxy.cn,direct

# 复制go.mod和go.sum文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 安装 air 热重载工具
RUN go install github.com/cosmtrek/air@latest

# 将air添加到PATH
ENV PATH="/go/bin:${PATH}"

# 安装文件系统监控工具
RUN apk add --no-cache git

# 使用air作为启动命令
CMD ["air", "-c", ".air.conf"]