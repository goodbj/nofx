# 使用官方Go镜像作为构建环境
FROM golang:1.25-alpine

# 设置工作目录
WORKDIR /app

# 配置Go模块代理以加速下载（适用于中国用户）
ENV GOPROXY=https://goproxy.cn,direct

# 安装文件系统监控工具和air热重载工具
RUN apk add --no-cache git && \
    go install github.com/air-verse/air@latest

# 复制go.mod和go.sum文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 暴露端口
EXPOSE 8080

# 运行应用 - 使用air进行热更新
CMD ["air", "-c", ".air.conf"]