# NoFx API端点配置
NOFX_API_ENDPOINT=http://127.0.0.1:8888/api

# Guardian配置
GUARDIAN_USER_DATA_DIR=./chrome_profile
GUARDIAN_AI_PROVIDER=deepseek
GUARDIAN_AI_ENDPOINT=https://chat.deepseek.com
GUARDIAN_PAGE_URL=https://chat.deepseek.com

# 可选配置
# GUARDIAN_API_KEY=your_api_key_here
# GUARDIAN_AUTH_TOKEN=your_auth_token_here
# GUARDIAN_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 监听配置
GUARDIAN_LISTEN_INTERVAL=5000  # 监听间隔（毫秒）