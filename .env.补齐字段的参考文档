# ===========================================
# AI Model Token Limits Configuration
# ===========================================

# Model token limits (characters/tokens) - 用于AI测试输出框的字符限制显示
# 注意：这些值是供前端显示参考的，默认单位为字符数
# 请勿随意修改此值，除非您了解不同AI模型的实际限制
# 如果删除这些变量，程序将使用内置的默认值

# DeepSeek 模型最大token数
MODEL_MAX_TOKENS_DEEPSEEK=32768

# GPT-4 模型最大token数
MODEL_MAX_TOKENS_GPT4=128000

# GPT-3.5 模型最大token数
MODEL_MAX_TOKENS_GPT35=16384

# Claude 模型最大token数
MODEL_MAX_TOKENS_CLAUDE=200000

# 通义千问(Qwen) 模型最大token数
MODEL_MAX_TOKENS_QWEN=32768

# 默认模型最大token数
MODEL_MAX_TOKENS_DEFAULT=4096

# ===========================================
# AI Model Pricing Configuration (for cost estimation)
# ===========================================

# Model pricing (per million tokens) - 用于AI测试输出框的成本估算
# 注意：这些值是供前端估算参考的，单位为元(RMB)或美元(USD)
# 请勿随意修改此值，除非您了解不同AI模型的实际价格
# 如果删除这些变量，程序将使用内置的默认值

# 通义千问系列
MODEL_PRICE_QWEN_MAX_INPUT=2.40      # qwen-max 输入价格 (元/百万tokens)
MODEL_PRICE_QWEN_MAX_OUTPUT=9.60     # qwen-max 输出价格 (元/百万tokens)
MODEL_PRICE_QWEN_PLUS_INPUT=1.00     # qwen-plus 输入价格 (元/百万tokens) - 使用平均值
MODEL_PRICE_QWEN_PLUS_OUTPUT=4.00    # qwen-plus 输出价格 (元/百万tokens) - 使用平均值

# OpenAI GPT系列
MODEL_PRICE_GPT4O_INPUT=2.50         # GPT-4o 输入价格 (美元/百万tokens)
MODEL_PRICE_GPT4O_OUTPUT=10.00       # GPT-4o 输出价格 (美元/百万tokens)
MODEL_PRICE_GPT4OMINI_INPUT=0.15     # GPT-4o-mini 输入价格 (美元/百万tokens)
MODEL_PRICE_GPT4OMINI_OUTPUT=0.60    # GPT-4o-mini 输出价格 (美元/百万tokens)

# Anthropic Claude系列
MODEL_PRICE_CLAUDE_SONNET_INPUT=3.00 # Claude 3.7 Sonnet 输入价格 (美元/百万tokens)
MODEL_PRICE_CLAUDE_SONNET_OUTPUT=15.00 # Claude 3.7 Sonnet 输出价格 (美元/百万tokens)

# DeepSeek系列
MODEL_PRICE_DEEPSEEK_INPUT=0.20      # Deepseek-Chat 输入价格 (元/百万tokens) - 按2元/百万tokens换算
MODEL_PRICE_DEEPSEEK_OUTPUT=0.80     # Deepseek-Chat 输出价格 (元/百万tokens) - 按8元/百万tokens换算

# 百度文心系列
MODEL_PRICE_WENXIN_ERINIE35_INPUT=0.08 # ERNIE-3.5-8K 输入价格 (元/百万tokens) - 按0.8元/百万tokens换算
MODEL_PRICE_WENXIN_ERINIE35_OUTPUT=0.20 # ERNIE-3.5-8K 输出价格 (元/百万tokens) - 按2元/百万tokens换算

# 默认价格 (当找不到特定模型价格时使用)
MODEL_PRICE_DEFAULT_INPUT=0.50       # 默认输入价格 (元/百万tokens)
MODEL_PRICE_DEFAULT_OUTPUT=2.00      # 默认输出价格 (元/百万tokens)

# ===========================================
# Cost Display Configuration
# ===========================================

# Cost display unit (USD, CNY, or BOTH) - 设置成本显示单位
# USD: 只显示美元价格
# CNY: 只显示人民币价格
# BOTH: 同时显示美元和人民币价格
COST_DISPLAY_UNIT=BOTH

# Exchange rate configuration (when showing CNY prices)
# 汇率配置 (当显示人民币价格时使用)
USD_TO_CNY_RATE=7.2                  # 1美元兑换多少人民币 (根据实际汇率调整)