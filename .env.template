# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Database Configuration - SQLite (Default)
# ===========================================
DB_TYPE=sqlite
DB_PATH=data/data.db

# For PostgreSQL (uncomment to use):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=nofx_user
# DB_PASSWORD=
# DB_NAME=nofx
# DB_SSLMODE=disable

# ===========================================
# Optional: External Services
# ===========================================

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# DeepSeek API key for AI features (optional but recommended)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ===========================================
# Guardian Browser Automation Polling Configuration
# ===========================================

# Initial wait time in seconds: How long to wait after AI starts outputting before polling for completion
# Default is 60 seconds, can be adjusted based on AI response time
GUARDIAN_INITIAL_WAIT_SECONDS=60                # Initial wait time in seconds

# Polling interval range in seconds: Time intervals for polling to detect if AI has finished outputting
# For testing phase, recommend setting to 2-5 seconds; for production, set to 10-20 seconds
GUARDIAN_MIN_POLL_SECONDS=2                     # Minimum polling interval in seconds
GUARDIAN_MAX_POLL_SECONDS=5                     # Maximum polling interval in seconds