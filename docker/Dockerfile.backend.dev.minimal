# 使用官方Go镜像作为基础镜像
FROM golang:1.21-alpine

# 安装必要的依赖（不安装chromium，因为构建时可能有问题）
RUN apk add --no-cache \
    ca-certificates \
    bash \
    git

# 设置工作目录
WORKDIR /app

# 复制go.mod和go.sum文件
COPY go.mod go.sum ./

# 设置Go工具链为自动检测兼容性
RUN go env -w GOTOOLCHAIN=auto

# 下载依赖（使用代理如果需要）
RUN go env -w GOPROXY=https://goproxy.cn,direct
RUN go mod download

# 复制源代码
COPY . .

# 构建Go应用程序
RUN go build -o main .

# 暴露端口
EXPOSE 8888

# 启动应用
CMD ["./main"]