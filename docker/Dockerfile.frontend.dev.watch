# docker/frontend/Dockerfile - Development with Hot Reload
# NOFX Frontend Dockerfile (Vite Development Server) - Development Watch Version
# Runs Vite development server on port 3030 with hot reload capability

ARG NODE_VERSION=20-alpine

# ──────────────────────────────────────────────────────────────
# Development Stage (Vite Dev Server)
# ──────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS dev-server

# 如果在开发环境中需要，可以设置npm使用国内镜像源
RUN npm config set registry https://registry.npmmirror.com/

WORKDIR /app

# Copy package files
COPY web/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY web/ ./

# Install all dependencies including antd
RUN npm install antd @ant-design/icons

# Expose port 3030 for Vite dev server
EXPOSE 3030

# Start Vite dev server with hot reload on port 3030
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3030"]