# 使用官方Go镜像作为基础镜像
FROM golang:1.21-alpine

# 安装必要的依赖
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    bash \
    git

# 设置环境变量以指向Chromium
ENV CHROME_BIN=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# 设置工作目录
WORKDIR /app

# 复制go.mod和go.sum文件
COPY go.mod go.sum ./

# 为特定依赖设置较低的Go版本要求
RUN go env -w GOTOOLCHAIN=auto

# 下载依赖
RUN go mod download

# 复制所有源代码到容器中
COPY . .

# 构建Go应用程序
RUN go build -o main .

# 暴露端口
EXPOSE 8888

# 启动应用
CMD ["./main"]