# .dockerignore 文件 - 排除构建上下文中的问题文件

# 排除浏览器锁文件和缓存文件
storage/guardian_browser_data_*/*
storage/guardian_browser_data_*/
storage/*/Singleton*
storage/*/Default/Cache/
storage/*/Default/Code Cache/
storage/*/Default/GPUCache/
storage/*/Default/Service Worker/

# 排除其他可能有问题的文件
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# 保留需要的目录结构但排除内容
storage/
!storage/